{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lead-engineer",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 8000
    }
  },
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 24576
  },
  "worktree": {
    "directory": "../ForgeOS-worktrees"
  },
  "experimental": {
    "subagent_depth": 1
  },
  "permissions": [
    {
      "action": "subagent",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git clean *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git checkout -- *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git checkout -f *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git restore *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git branch -D *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push --force*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push -f *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git merge *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git rebase *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git branch -d *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git branch --delete *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git branch -f *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git checkout -B *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git switch -C *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git switch --discard-changes *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git worktree remove *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git worktree prune *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git stash drop *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git stash clear *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git commit --amend *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh pr create *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh pr merge *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "opencode run *",
      "effect": "ask"
    }
  ]
}
